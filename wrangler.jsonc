{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dj-kimchi",
  // OpenNext refreshes stale cached pages (revalidate) by calling this Worker
  // through this binding; without it the refresh is skipped and every
  // request renders the page again.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "dj-kimchi" }],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Runtime secrets are set with `npx wrangler secret put NAME` or in the Cloudflare dashboard.
  "keep_vars": true,
  "workers_dev": true,
  "routes": [{ "pattern": "dj-kimchi.rauell.systems", "custom_domain": true }],
  "observability": { "enabled": true },
  // Page cache for open-next.config.ts.
  "kv_namespaces": [
    { "binding": "NEXT_INC_CACHE_KV", "id": "37d05be013ea4582b9a132d75e9b398b" }
  ]
}
