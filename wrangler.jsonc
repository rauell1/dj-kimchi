{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dj-kimchi",
  // OpenNext refreshes stale cached pages (revalidate) by calling this Worker
  // through this binding; without it the refresh is skipped and every
  // request renders the page again.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "dj-kimchi" }],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Runtime secrets are set with `npx wrangler secret put NAME` or in the Cloudflare dashboard.
  "keep_vars": true,
  // Only dj-kimchi.rauell.systems serves the site: a workers.dev address would
  // skip the zone firewall rules.
  "workers_dev": false,
  // Booking form: 5 requests per minute per visitor, shared by every Worker copy.
  "ratelimits": [
    { "name": "BOOKING_RATE_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }
  ],
  "routes": [{ "pattern": "dj-kimchi.rauell.systems", "custom_domain": true }],
  "observability": { "enabled": true },
  // Page cache for open-next.config.ts (pages kept in R2; the bucket was
  // created ahead of the deploy).
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "dj-kimchi-next-cache" }
  ]
}
