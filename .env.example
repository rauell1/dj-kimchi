# Copy to .env.local for local development. Placeholders only: never put real values here.
# Production values: NEXT_PUBLIC_SITE_URL is a GitHub repository variable (read at build
# time); the others are Cloudflare Worker secrets.

# Canonical site address used for metadata, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key for booking emails. Without it, bookings are not emailed.
RESEND_API_KEY=re_your_key_here

# Signing secret for the Resend inbound webhook (/api/webhooks/inbound).
RESEND_WEBHOOK_SECRET=whsec_your_secret_here

# Optional, local development only: SQLite file for the Prisma booking store.
# Leave unset in production; bookings are delivered by email.
DATABASE_URL=file:./dev.db
